# === Supabase ===
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>

# === ChromaDB ===
CHROMA_HOST=chroma-service
CHROMA_PORT=8000
CHROMA_COLLECTION=documents
CHROMA_CHUNKED_COLLECTION=chunked_chats
CHROMA_PAGE_SIZE=2000

# === Verificación con RoBERTa ===
VERIFY_MODEL_ID=vibhorag101/roberta-base-suicide-prediction-phr
VERIFY_VRAM_MB=1500

# === Hugging Face (opcional) ===
HF_TOKEN=

# === Model cache (opcional) ===
# risk usa ModelSlot para el verificador RoBERTa (TTL y evicción aplican).
# WARMUP no se lee en este servicio.
MODEL_TTL_SECONDS=600
MODEL_VRAM_MARGIN_MB=512
MODEL_EVICT_POLL_SECONDS=0

LOG_LEVEL=INFO
