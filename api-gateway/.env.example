# === Supabase ===
# Solo se usa para obtener el JWKS con el que se validan los JWT.
SUPABASE_URL=https://<project-ref>.supabase.co

# === URLs internas de los microservicios ===
# En Docker se resuelven por el nombre del servicio en la red `microservicios`.
# Las barras finales son opcionales; el gateway normaliza la unión con cada ruta.
# analysis-service agrupa varios prefijos públicos mediante sus respectivas URLs.
CLUSTERING_SERVICE_URL=http://analysis-service:8080/clustering
DATASET_SERVICE_URL=http://dataset-service:8082
TOPIC_MODELING_SERVICE_URL=http://analysis-service:8080/topicmodeling
WORDCLOUD_SERVICE_URL=http://analysis-service:8080/wordcloud
EDA_SERVICE_URL=http://analysis-service:8080/eda
EMOTIONS_SERVICE_URL=http://analysis-service:8080/emotions
CLASSIFICATION_SERVICE_URL=http://classification-service:8087
RAG_SERVICE_URL=http://rag-service:8088
DATA_CLEANING_SERVICE_URL=http://cleaning-service:8089
EVOLUTION_SERVICE_URL=http://evolution-service:8090
SUICIDE_SERVICE_URL=http://analysis-service:8080/suicide
REPORT_SERVICE_URL=http://report-service:8092
AUTH_SERVICE_URL=http://auth-service:5050

# === Opcional ===
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
