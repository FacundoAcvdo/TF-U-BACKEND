# === Aplicación ===
APP_NAME=Dataset Service
APP_VERSION=1.0.0

# === Supabase ===
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SECRET_KEY=<supabase-service-role-key>
SUPABASE_DATASETS_TABLE=datasets

# === ChromaDB ===
CHROMA_HOST=chroma-service
CHROMA_PORT=8000
CHROMA_TOKEN=
CHROMA_COLLECTION_NAME=documents
CHROMA_PAGE_SIZE=2000

# === Generación de títulos con Gemini ===
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash
TITLE_ENABLED=true
TITLE_BATCH_SIZE=20
TITLE_MAX_CHARS_PER_DOC=400

# === Hugging Face (opcional) ===
HF_TOKEN=

# === Model cache (opcional) ===
# topicmodeling solo usa check_fits_or_raise(): únicamente aplica el margen de VRAM.
# No instancia ModelSlot, así que WARMUP, MODEL_TTL_SECONDS y
# MODEL_EVICT_POLL_SECONDS no tienen efecto.
MODEL_VRAM_MARGIN_MB=512

LOG_LEVEL=INFO
