# === Aplicación ===
APP_NAME=Dataset Service
APP_VERSION=1.0.0
MAX_UPLOAD_SIZE_MB=50
# Token opcional para llamadas internas entre servicios
INTERNAL_SERVICE_TOKEN=

# === Supabase ===
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SECRET_KEY=<supabase-service-role-key>
SUPABASE_DATASETS_TABLE=datasets

# === ChromaDB ===
CHROMA_HOST=chroma-service
CHROMA_PORT=8000
CHROMA_TOKEN=
CHROMA_COLLECTION_NAME=documents
CHROMA_CHUNKED_COLLECTION_NAME=chunked_chats

# === Embeddings ===
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
# auto | cuda | cpu
EMBEDDING_DEVICE=auto
EMBEDDING_FP16=true
EMBEDDING_VRAM_MB=1500
INGEST_CHUNK_SIZE=2000

# === Chunking de chats ===
CHAT_CHUNK_SIZE=20
CHAT_CHUNK_OVERLAP=4

# === CORS ===
CORS_ORIGINS=http://localhost:8080,http://localhost:7500,http://localhost:6001

# === Hugging Face (opcional) ===
HF_TOKEN=

# === Model cache (opcional) ===
# dataset usa ModelSlot para embeddings: TTL y evicción sí aplican.
# WARMUP no se lee en este servicio.
MODEL_TTL_SECONDS=600
MODEL_VRAM_MARGIN_MB=512
MODEL_EVICT_POLL_SECONDS=0

LOG_LEVEL=INFO
