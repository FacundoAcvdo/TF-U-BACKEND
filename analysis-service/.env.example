# === Supabase ===
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SECRET_KEY=<supabase-service-role-key>
SUPABASE_DATASETS_TABLE=datasets

# === ChromaDB ===
CHROMA_HOST=chroma-service
CHROMA_PORT=8000
CHROMA_COLLECTION=documents
CHROMA_COLLECTION_NAME=documents
CHROMA_CHUNKED_COLLECTION=chunked_chats
CHROMA_PAGE_SIZE=2000
CHROMA_TOKEN=

# === Topic titles (Groq / Google / Ollama local) ===
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=4096
TITLE_ENABLED=true
TITLE_BATCH_SIZE=20
TITLE_MAX_CHARS_PER_DOC=400

# === Hugging Face/model cache (optional) ===
HF_TOKEN=
WARMUP=true
MODEL_TTL_SECONDS=600
MODEL_VRAM_MARGIN_MB=512
MODEL_EVICT_POLL_SECONDS=0
VERIFY_MODEL_ID=vibhorag101/roberta-base-suicide-prediction-phr
VERIFY_VRAM_MB=1500

LOG_LEVEL=INFO
