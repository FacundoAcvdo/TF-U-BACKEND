# === Supabase ===
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>

# === ChromaDB ===
CHROMA_HOST=chroma-service
CHROMA_PORT=8000
CHROMA_COLLECTION=rag_docs
CHROMA_COLLECTION_DOCUMENTS=documents
CHROMA_COLLECTION_CHUNKED=chunked_chats
# true para usar Chroma persistente local si chroma-service no está disponible
CHROMA_FALLBACK_LOCAL=false

# === Embeddings ===
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_BATCH_SIZE=32
RAG_EMB_VRAM_MB=800

# === Ingesta de documentos ===
DOCS_PATH=/app/data/rag_docs
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
RAG_INIT_ON_STARTUP=false

# === Recuperación / reranking ===
TOP_K=4
RETRIEVE_K=12
RERANK=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_MIN_SCORE=-2.0

# === Historial de conversación ===
HISTORY_TAIL=4
HISTORY_MSG_CHARS=600
HISTORY_MAX_CHARS=2000

# === LLM ===
# google | groq
LLM_PROVIDER=groq
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# === Modo privacidad (Ollama) ===
# Ollama debe ser accesible desde rag-service. Qwen3:8b es el modelo local
# cuantizado recomendado para equipos con 12 GB de VRAM compartida.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
# Ollama descarga el modelo tras este tiempo sin solicitudes.
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=4096

# === Hugging Face (opcional) ===
HF_TOKEN=

# === Model cache (opcional) ===
WARMUP=true
MODEL_TTL_SECONDS=600
MODEL_VRAM_MARGIN_MB=512
MODEL_EVICT_POLL_SECONDS=0

LOG_LEVEL=INFO
