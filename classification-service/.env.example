# === Supabase ===
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>

# === Embeddings / ChromaDB ===
# El host y puerto de Chroma están hardcodeados en core.py (chroma-service:8000).
CHROMA_COLLECTION=documents
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# === Entrenamiento ===
MAX_CLASES=7
MODEL_STORAGE_PATH=/app/data/modelos
# TTL de los ZIP de modelos entrenados en disco (horas).
# No confundir con MODEL_TTL_SECONDS del model_cache.
MODEL_TTL_HOURS=24
# auto | cuda | cpu (vacío = auto)
CLASSIFICATION_FORCE_DEVICE=
# Los modelos BERT están definidos en training.py (MODELOS_BERT).
TOKENIZERS_PARALLELISM=false

# === Hugging Face (opcional) ===
HF_TOKEN=

# classification no importa model_cache.py: WARMUP, MODEL_TTL_SECONDS,
# MODEL_VRAM_MARGIN_MB y MODEL_EVICT_POLL_SECONDS no tienen efecto aquí.

LOG_LEVEL=INFO
